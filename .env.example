# Development defaults bind the API to the local machine only.
HOST=127.0.0.1
PORT=4735
DB_PATH=./server/database.sqlite
BACKUP_DIR=./server/backups

# Keep this value on the server. It must never be exposed through Vite variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Required for cross-origin production deployments; comma-separated.
ALLOWED_ORIGINS=
MAX_IMPORT_ROWS=10000

# Required when NODE_ENV=production binds to a non-loopback interface.
ACCESS_TOKEN=
# Set true only when an authenticating reverse proxy is the exclusive ingress path.
TRUST_PROXY_AUTH=false
# Keep true behind HTTPS. Set false only for trusted-network HTTP testing.
COOKIE_SECURE=true
